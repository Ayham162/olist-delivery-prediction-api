# Copy to .env and fill in. .env is gitignored, never commit real credentials.

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=olist
POSTGRES_USER=olist
POSTGRES_PASSWORD=changeme

# Docker Compose value, talks to the mlflow service over HTTP. For local dev
# without Docker, use a DB-backed URI instead, e.g. sqlite:///mlflow.db.
# Not file:./mlruns: that backend is in maintenance mode as of mlflow==3.16.1
# and refuses to start.
MLFLOW_TRACKING_URI=http://mlflow:5000
